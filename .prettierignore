# Prettier also reads .gitignore, so this file only has to state the things
# that are genuinely prettier's business to skip rather than git's.

# Cargo build output and Tauri's regenerated permission schemas.
target/
apps/desktop/src-tauri/gen/

# Package managers own their lockfiles' formatting. Prettier reformatting
# pnpm-lock.yaml rewrites ~14k lines that pnpm then rewrites back on the next
# install, and buries real dependency changes in review.
Cargo.lock
pnpm-lock.yaml

# Emitted by `cargo test -p shiranami-core` (specta). Prettier reformatting it
# would put the formatter and the generator in a loop and make the
# regenerate-and-diff guard fail for reasons that have nothing to do with drift.
packages/contracts/src/generated/

# Captured verbatim from Spotify's embed endpoint; must stay byte-identical to
# the real (minified) response the parser is tested against. Copied from v1
# before the Electron app was deleted, so reformatting it would test the
# parser against a page Spotify never served.
crates/shiranami-downloader/fixtures/

# Local generated artifacts (gitignored, but this repo's prettier setup does
# not read .gitignore, so format:check trips over them in a used checkout).
apps/landing/.astro/
apps/mobile/.expo/
apps/mobile/expo-env.d.ts
apps/server/src/generated/

# Written by v1's own writeCachedPeaks (JSON.stringify, no trailing newline).
# The peaks-cache compatibility test asserts the v2 writer reproduces these
# bytes exactly, so reformatting them would assert the formatter instead.
crates/shiranami-audio/tests/fixtures/v1-peaks-cache/

# A frozen record of v1's schema, generated from v1's migrations before the
# Electron app was deleted. Nothing can regenerate it now, so keep it exactly
# as recorded.
crates/shiranami-db/fixtures/
