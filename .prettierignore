# Prettier also reads .gitignore, so this file only has to state the things
# that are genuinely prettier's business to skip rather than git's.

# Cargo build output and Tauri's regenerated permission schemas.
target/
apps/desktop-tauri/src-tauri/gen/

# Package managers own their lockfiles' formatting. Prettier reformatting
# pnpm-lock.yaml rewrites ~14k lines that pnpm then rewrites back on the next
# install, and buries real dependency changes in review.
Cargo.lock
pnpm-lock.yaml
