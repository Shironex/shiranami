# Prettier also reads .gitignore, so this file only has to state the things
# that are genuinely prettier's business to skip rather than git's.

# Cargo build output and Tauri's regenerated permission schemas.
target/
apps/desktop-tauri/src-tauri/gen/

# Package managers own their lockfiles' formatting. Prettier reformatting
# pnpm-lock.yaml rewrites ~14k lines that pnpm then rewrites back on the next
# install, and buries real dependency changes in review.
Cargo.lock
pnpm-lock.yaml

# Emitted by `cargo test -p shiranami-core` (specta). Prettier reformatting it
# would put the formatter and the generator in a loop and make the
# regenerate-and-diff guard fail for reasons that have nothing to do with drift.
packages/contracts/src/generated/

# Captured verbatim from Spotify's embed endpoint; must stay byte-identical to
# the real (minified) response the parser is tested against.
apps/desktop/src/main/ipc/__fixtures__/spotify-embed-playlist.html
