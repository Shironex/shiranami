{
  "name": "shiranami",
  "version": "0.24.0",
  "private": true,
  "description": "Shiranami - Your personal music sanctuary",
  "license": "SEE LICENSE IN LICENSE",
  "packageManager": "pnpm@10.9.0",
  "scripts": {
    "dev": "pnpm build:packages && concurrently -k -n web,desktop -c cyan,yellow \"pnpm dev:web\" \"wait-on -t 30000 -i 1000 http-get://localhost:15175 && pnpm --filter @shiranami/desktop dev\"",
    "dev:inspect": "pnpm build:packages && concurrently -k -n web,desktop -c cyan,yellow \"pnpm dev:web\" \"wait-on -t 30000 -i 1000 http-get://localhost:15175 && pnpm --filter @shiranami/desktop dev:inspect\"",
    "dev:web": "pnpm --filter @shiranami/web dev",
    "dev:landing": "pnpm --filter @shiranami/landing dev",
    "dev:mobile": "pnpm --filter @shiranami/mobile dev",
    "dev:sentry": "node scripts/dev-sentry.mjs",
    "build": "pnpm build:packages && pnpm --filter @shiranami/web build && pnpm --filter @shiranami/desktop build",
    "build:packages": "pnpm --filter @shiranami/contracts build && pnpm --filter @shiranami/shared build && pnpm --filter @shiranami/database build && pnpm --filter @shiranami/recommendation build",
    "build:landing": "pnpm --filter @shiranami/landing build",
    "package": "pnpm build && pnpm --filter @shiranami/desktop package",
    "package:win": "pnpm build && pnpm --filter @shiranami/desktop package:win",
    "package:mac": "pnpm build && pnpm --filter @shiranami/desktop package:mac",
    "lint": "pnpm --filter @shiranami/eslint-plugin build && eslint .",
    "lint:meta": "tsx tools/lint-meta/cli.ts",
    "new:component": "tsx tools/codegen/new-component.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check:landing": "pnpm --filter @shiranami/landing check",
    "typecheck": "pnpm build:packages && pnpm --filter @shiranami/web typecheck && pnpm --filter @shiranami/desktop typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "test:e2e": "pnpm --filter @shiranami/desktop test:e2e",
    "version:patch": "node scripts/bump-version.mjs patch",
    "version:minor": "node scripts/bump-version.mjs minor",
    "version:major": "node scripts/bump-version.mjs major",
    "rebuild:electron": "pnpm --filter @shiranami/desktop rebuild",
    "generate-icons": "node scripts/generate-icons.mjs",
    "screenshots": "node scripts/screenshot-app.mjs",
    "prepare": "husky"
  },
  "engines": {
    "node": ">=22.12.0",
    "pnpm": ">=9.0.0"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml,css}": [
      "prettier --write"
    ]
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.1",
    "@shiranami/eslint-plugin": "workspace:*",
    "@commitlint/config-conventional": "^21.0.1",
    "@eslint/js": "^10.0.1",
    "@vitest/coverage-v8": "^4.1.10",
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "eslint": "^10.4.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.5.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.5",
    "playwright": "^1.60.0",
    "png-to-ico": "^3.0.1",
    "prettier": "^3.8.3",
    "sharp": "^0.35.3",
    "sql.js": "^1.14.1",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.59.4",
    "vitest": "^4.1.10",
    "wait-on": "^9.0.10"
  }
}
