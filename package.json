{
  "name": "shiranami",
  "version": "0.1.0",
  "private": true,
  "description": "Shiranami — Your personal music player",
  "license": "MIT",
  "packageManager": "pnpm@10.9.0",
  "pnpm": {
    "onlyBuiltDependencies": [
      "electron",
      "esbuild",
      "better-sqlite3"
    ]
  },
  "scripts": {
    "dev": "pnpm build:packages && concurrently -k -n web,desktop -c cyan,yellow \"pnpm dev:web\" \"wait-on http://localhost:15175 && pnpm --filter @shiranami/desktop dev\"",
    "dev:web": "pnpm --filter @shiranami/web dev",
    "build": "pnpm build:packages && pnpm --filter @shiranami/web build && pnpm --filter @shiranami/desktop build",
    "build:packages": "pnpm --filter @shiranami/shared build",
    "package": "pnpm build && pnpm --filter @shiranami/desktop package",
    "package:win": "pnpm build && pnpm --filter @shiranami/desktop package:win",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "pnpm build:packages && pnpm --filter @shiranami/web typecheck && pnpm --filter @shiranami/desktop typecheck",
    "prepare": "husky"
  },
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=9.0.0"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml,css}": [
      "prettier --write"
    ]
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "concurrently": "^9.2.1",
    "eslint": "^10.0.3",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.4.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.3.3",
    "prettier": "^3.8.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.57.0",
    "wait-on": "^9.0.4"
  }
}
