{
  "name": "@shiranami/desktop",
  "version": "0.15.0",
  "description": "Shiranami desktop application",
  "author": {
    "name": "Shironex"
  },
  "private": true,
  "main": "dist/main/index.js",
  "scripts": {
    "dev": "node esbuild.config.mjs && cross-env NODE_ENV=development electron .",
    "build": "node esbuild.config.mjs && node scripts/copy-renderer.mjs",
    "typecheck": "tsc -p tsconfig.build.json --noEmit",
    "test": "node ../../scripts/run-vitest.mjs run --project desktop",
    "test:watch": "node ../../scripts/run-vitest.mjs --project desktop",
    "test:cov": "node ../../scripts/run-vitest.mjs run --project desktop --coverage",
    "package": "pnpm build && electron-builder --config electron-builder.json",
    "package:win": "pnpm build && electron-builder --config electron-builder.json --win",
    "package:mac": "pnpm build && electron-builder --config electron-builder.json --mac",
    "postinstall": "electron-builder install-app-deps",
    "rebuild": "electron-builder install-app-deps"
  },
  "dependencies": {
    "@xhayper/discord-rpc": "^1.3.3",
    "adm-zip": "^0.5.17",
    "better-sqlite3": "^12.6.2",
    "electron-store": "^8.2.0",
    "electron-updater": "^6.8.3",
    "flac-tagger": "^2.0.0",
    "lrclib-api": "^2.0.4",
    "music-metadata": "^11.12.3",
    "node-addon-api": "^8.6.0",
    "node-id3": "^0.2.9",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.0.3",
    "@shiranami/database": "workspace:*",
    "@shiranami/shared": "workspace:*",
    "@types/adm-zip": "^0.5.8",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^25.5.2",
    "cross-env": "^10.1.0",
    "electron": "^41.2.0",
    "electron-builder": "^26.8.1",
    "esbuild": "^0.28.0"
  }
}
