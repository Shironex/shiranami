{
  "name": "@shiranami/desktop",
  "version": "0.19.0",
  "description": "Shiranami desktop application",
  "author": {
    "name": "Shironex"
  },
  "private": true,
  "main": "dist/main/index.js",
  "scripts": {
    "dev": "node esbuild.config.mjs && cross-env NODE_ENV=development electron .",
    "dev:inspect": "node esbuild.config.mjs && cross-env NODE_ENV=development electron . --remote-debugging-port=9222 --remote-allow-origins=*",
    "build": "node esbuild.config.mjs && node scripts/copy-renderer.mjs",
    "typecheck": "tsc -p tsconfig.build.json --noEmit",
    "test": "vitest run --project desktop",
    "test:watch": "vitest --project desktop",
    "test:cov": "vitest run --project desktop --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "package": "pnpm build && electron-builder --config electron-builder.json",
    "package:win": "pnpm build && electron-builder --config electron-builder.json --win",
    "package:mac": "pnpm build && electron-builder --config electron-builder.json --mac",
    "postinstall": "electron-builder install-app-deps",
    "rebuild": "electron-builder install-app-deps"
  },
  "dependencies": {
    "@sentry/electron": "7.13.0",
    "@xhayper/discord-rpc": "^1.3.4",
    "adm-zip": "^0.5.17",
    "better-sqlite3": "^12.10.0",
    "electron-store": "^8.2.0",
    "electron-updater": "^6.8.3",
    "flac-tagger": "^2.0.0",
    "ipaddr.js": "^2.4.0",
    "lrclib-api": "^2.0.4",
    "music-metadata": "^11.12.3",
    "node-addon-api": "^8.8.0",
    "node-id3": "^0.2.9",
    "sharp": "^0.34.5",
    "zod": "^4.4.3"
  },
  "optionalDependencies": {
    "@img/sharp-darwin-arm64": "0.34.5",
    "@img/sharp-darwin-x64": "0.34.5",
    "@img/sharp-libvips-darwin-arm64": "1.2.4",
    "@img/sharp-libvips-darwin-x64": "1.2.4",
    "@img/sharp-win32-arm64": "0.34.5",
    "@img/sharp-win32-x64": "0.34.5"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.0.4",
    "@playwright/test": "^1.60.0",
    "@sentry/esbuild-plugin": "5.3.0",
    "@shiranami/contracts": "workspace:*",
    "@shiranami/database": "workspace:*",
    "@shiranami/shared": "workspace:*",
    "@types/adm-zip": "^0.5.8",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^25.9.1",
    "cross-env": "^10.1.0",
    "electron": "^41.7.0",
    "electron-builder": "^26.8.1",
    "esbuild": "^0.28.0"
  }
}
