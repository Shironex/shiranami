{
  "$schema": "https://raw.githubusercontent.com/electron-userland/electron-builder/master/packages/app-builder-lib/scheme.json",
  "appId": "com.shironex.shiranami",
  "productName": "Shiranami",
  "directories": {
    "output": "release",
    "buildResources": "resources"
  },
  "files": [
    "dist/**/*",
    "package.json",
    "!**/*.map",
    "!**/*.d.ts",
    "!dist/**/*.d.ts",
    "!**/node_modules/better-sqlite3/deps/**",
    "!**/node_modules/better-sqlite3/src/**",
    "!**/node_modules/better-sqlite3/build/Release/obj/**",
    "!**/node_modules/better-sqlite3/build/Release/obj.target/**",
    "!**/node_modules/better-sqlite3/build/Release/.deps/**",
    "!**/node_modules/better-sqlite3/build/Release/*.a",
    "!**/node_modules/better-sqlite3/build/**/*.{c,h,cc,cpp,o,d,mk,Makefile,gypi}",
    "!**/node_modules/better-sqlite3/build/Makefile",
    "!**/node_modules/better-sqlite3/build/binding.Makefile",
    "!**/node_modules/better-sqlite3/build/config.gypi",
    "!**/node_modules/better-sqlite3/build/gyp-mac-tool"
  ],
  "extraResources": [
    { "from": "resources/tray-icon.png", "to": "tray-icon.png" },
    { "from": "resources/icon-16.png", "to": "icon-16.png" },
    { "from": "resources/icon-32.png", "to": "icon-32.png" },
    { "from": "resources/icon.png", "to": "icon.png" },
    { "from": "resources/icon.ico", "to": "icon.ico" }
  ],
  "asarUnpack": [
    "**/node_modules/better-sqlite3/**",
    "**/node_modules/sharp/**",
    "**/node_modules/@img/**"
  ],
  "artifactName": "${productName}-${version}-${arch}.${ext}",
  "nodeGypRebuild": false,
  "npmRebuild": false,
  "electronFuses": {
    "runAsNode": false,
    "enableNodeCliInspectArguments": false,
    "enableNodeOptionsEnvironmentVariable": false,
    "onlyLoadAppFromAsar": true
  },
  "publish": {
    "provider": "github",
    "owner": "Shironex",
    "repo": "shiranami"
  },
  "mac": {
    "category": "public.app-category.music",
    "icon": "resources/icon.png",
    "target": ["dmg"]
  },
  "win": {
    "icon": "resources/icon.ico",
    "target": ["nsis"]
  },
  "nsis": {
    "oneClick": false,
    "allowToChangeInstallationDirectory": true,
    "createDesktopShortcut": true,
    "createStartMenuShortcut": true
  }
}
