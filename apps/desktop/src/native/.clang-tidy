# clang-tidy ≈ ESLint for C++ (static analysis, not just formatting).
#
# The clangd editor extension runs these checks inline with NO extra install.
# The CLI (`pnpm native:lint`) needs the LLVM binary: `brew install llvm`, and
# reads compile_commands.json, so run `pnpm native:ide` first.
#
# Focused, low-noise set: real-bug + performance + a few modern-C++ idioms.
# Intentionally NOT enabling readability-braces-around-statements — this code
# deliberately uses brace-less single statements (`if (a > peak) peak = a;`).
# Vendored sources are skipped by the lint script's path filter; HeaderFilter
# keeps it to our own headers.
Checks: >
  -*,
  bugprone-*,
  performance-*,
  modernize-use-nullptr,
  modernize-use-override,
  modernize-use-using,
  modernize-use-equals-default,
  -bugprone-easily-swappable-parameters
HeaderFilterRegex: 'src/native/(core|waveform|loudness|bpm)/'
WarningsAsErrors: ''
FormatStyle: file
