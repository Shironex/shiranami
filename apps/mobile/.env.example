# Copy to .env.local (git ignores it). Expo CLI reads it from apps/mobile and
# Babel inlines EXPO_PUBLIC_* values into the bundle at build time, so restart
# Metro with a clean cache after a change: pnpm dev (runs expo start -c).
# Anything prefixed EXPO_PUBLIC_ is readable by anyone who has the app: never
# put secrets here. lib/env.ts validates these at startup; all are optional.

# Default Shiranami server URL (Settings can change it on the device). The
# emulator reaches the host machine at 10.0.2.2; a phone on the same network
# uses the computer's LAN address, e.g. http://192.168.1.20:3000.
EXPO_PUBLIC_API_URL=http://10.0.2.2:3000

# Value for the x-shiranami-key header: the server's API_KEY. YouTube search
# and saving need it; without it the Search tab says the build has no key.
EXPO_PUBLIC_API_KEY=

# Shows the YouTube search tab ("true" or "false"). On when unset.
EXPO_PUBLIC_FEATURE_YOUTUBE_SEARCH=true
