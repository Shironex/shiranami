{
  "expo": {
    "name": "Shiranami",
    "slug": "shiranami",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "shiranami",
    "platforms": ["android", "ios"],
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.shiranami.mobile",
      "infoPlist": {
        "UIBackgroundModes": ["audio"],
        "NSAppleMusicUsageDescription": "Shiranami needs access to your music library to import tracks.",
        "NSDocumentsFolderUsageDescription": "Shiranami needs access to your files to import music."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "monochromeImage": "./assets/images/adaptive-icon-monochrome.png",
        "backgroundColor": "#1c1c42"
      },
      "icon": "./assets/images/icon.png",
      "package": "com.shiranami.mobile",
      "permissions": [
        "android.permission.READ_MEDIA_AUDIO",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.INTERNET",
        "android.permission.ACCESS_NETWORK_STATE",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.CAMERA"
      ],
      "blockedPermissions": [
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.READ_MEDIA_VISUAL_USER_SELECTED",
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "backgroundColor": "#010105"
        }
      ],
      [
        "expo-font",
        {
          "fonts": [
            "./node_modules/@expo-google-fonts/dm-sans/400Regular/DMSans_400Regular.ttf",
            "./node_modules/@expo-google-fonts/dm-sans/500Medium/DMSans_500Medium.ttf",
            "./node_modules/@expo-google-fonts/dm-sans/600SemiBold/DMSans_600SemiBold.ttf",
            "./node_modules/@expo-google-fonts/sora/500Medium/Sora_500Medium.ttf",
            "./node_modules/@expo-google-fonts/sora/600SemiBold/Sora_600SemiBold.ttf",
            "./assets/fonts/ShipporiMincho_700Bold.ttf"
          ]
        }
      ],
      "expo-sqlite",
      [
        "expo-quick-actions",
        {
          "androidIcons": {
            "shortcut_play": {
              "foregroundImage": "./assets/images/shortcuts/shortcut-play.png",
              "backgroundColor": "#1c1c42"
            },
            "shortcut_radio": {
              "foregroundImage": "./assets/images/shortcuts/shortcut-radio.png",
              "backgroundColor": "#1c1c42"
            },
            "shortcut_shuffle": {
              "foregroundImage": "./assets/images/shortcuts/shortcut-shuffle.png",
              "backgroundColor": "#1c1c42"
            }
          }
        }
      ],
      [
        "expo-audio",
        {
          "enableBackgroundPlayback": true,
          "recordAudioAndroid": false,
          "microphonePermission": false
        }
      ],
      [
        "expo-document-picker",
        {
          "iCloudContainerEnvironment": "Production"
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Shiranami uses the camera to scan the pairing code on your desktop.",
          "microphonePermission": false,
          "recordAudioAndroid": false,
          "barcodeScannerEnabled": true
        }
      ],
      "expo-secure-store",
      [
        "expo-build-properties",
        {
          "android": {
            "enableMinifyInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true,
            "usesCleartextTraffic": true
          }
        }
      ]
    ],
    "runtimeVersion": {
      "policy": "fingerprint"
    },
    "updates": {
      "url": "https://u.expo.dev/a4dc1d83-4979-4ae8-b0ed-1650233b0bdf",
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0
    },
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "eas": {
        "projectId": "a4dc1d83-4979-4ae8-b0ed-1650233b0bdf"
      }
    },
    "owner": "shirone-dev"
  }
}
