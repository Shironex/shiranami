---
const features = [
  {
    icon: '\u266B',
    title: 'Library first',
    body: 'Built around your own folders and files, not around pushing you into an online catalog.',
    titleKey: 'features.libraryFirst',
    bodyKey: 'features.libraryFirstBody',
  },
  {
    icon: '\u2913',
    title: 'Search & download',
    body: 'Find tracks on YouTube, preview audio before downloading, and pull full YouTube or Spotify playlists in one go.',
    titleKey: 'features.searchDownload',
    bodyKey: 'features.searchDownloadBody',
  },
  {
    icon: '\u25B6',
    title: 'Crossfade & playback resume',
    body: 'Dual-deck engine with smooth equal-power crossfade. Volume, queue, and position all survive restarts.',
    titleKey: 'features.crossfade',
    bodyKey: 'features.crossfadeBody',
  },
  {
    icon: '\u2728',
    title: 'Synced lyrics',
    body: 'Timestamped lyrics scroll with the music. Click any line to seek. Falls back to plain text when needed.',
    titleKey: 'features.lyrics',
    bodyKey: 'features.lyricsBody',
  },
  {
    icon: '\uD83C\uDFB5',
    title: 'Internet radio',
    body: 'Browse and stream stations from Radio Browser. Favorite the ones you like for quick access.',
    titleKey: 'features.radio',
    bodyKey: 'features.radioBody',
  },
  {
    icon: '\uD83C\uDF19',
    title: 'Sleep timer & compact mode',
    body: 'Set a timer and let it auto-pause. Switch to a mini player with always-on-top when you want less screen.',
    titleKey: 'features.sleepTimer',
    bodyKey: 'features.sleepTimerBody',
  },
  {
    icon: '\uD83C\uDFA8',
    title: 'Ambient color & visualizer',
    body: 'The UI tints itself to the album art. A frequency bar or waveform strip plays above the player bar.',
    titleKey: 'features.ambient',
    bodyKey: 'features.ambientBody',
  },
  {
    icon: '\u2726',
    title: 'Quiet interface touches',
    body: 'Collapsible sidebar, command palette, listening history with stats, Discord Rich Presence, and adjustable UI scale.',
    titleKey: 'features.quiet',
    bodyKey: 'features.quietBody',
  },
];
---

<section class="section-shell section-stack" id="features">
  <div class="section-heading reveal">
    <div class="pill" data-i18n="features.pill">What makes it feel like Shiranami</div>
    <h2 data-i18n="features.heading">Everything is aimed at a calmer listening flow.</h2>
    <p data-i18n="features.subheading">
      Less reloading, less setup repetition, and fewer panels fighting for attention while you listen.
    </p>
  </div>

  <div class="feature-grid reveal-stagger">
    {features.map((feature) => (
      <article class="feature-card reveal">
        <span class="feature-icon" aria-hidden="true">{feature.icon}</span>
        <h3 data-i18n={feature.titleKey}>{feature.title}</h3>
        <p data-i18n={feature.bodyKey}>{feature.body}</p>
      </article>
    ))}
  </div>
</section>
