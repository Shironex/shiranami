---

<footer class="foot">
  <div class="page">
    <div class="foot-grid">
      <div class="foot-brand">
        <div class="brand">
          <span class="brand-mark" aria-hidden="true">
            <img src="/assets/mascot.png" alt="" width="38" height="38" />
          </span>
          <div>
            <div class="brand-name">Shiranami</div>
            <div class="brand-sub">white waves · 白波</div>
          </div>
        </div>
        <div class="blurb" data-i18n="footer.blurb">
          "A calm desktop player for your local music library, synced lyrics, and a slow dial
          across the radio."
        </div>
      </div>

      <div class="foot-col">
        <h5 data-i18n="footer.col.app">The app</h5>
        <ul>
          <li><a href="/download" data-i18n="footer.link.download">Download</a></li>
          <li><a href="/changelog" data-i18n="footer.link.changelog">Changelog</a></li>
          <li><a href="#features" data-i18n="footer.link.features">Features</a></li>
          <li><a href="#preview" data-i18n="footer.link.preview">The app</a></li>
        </ul>
      </div>

      <div class="foot-col">
        <h5 data-i18n="footer.col.source">Source</h5>
        <ul>
          <li><a href="https://github.com/Shironex/shiranami" target="_blank" rel="noreferrer">GitHub</a></li>
          <li>
            <a
              href="https://github.com/Shironex/shiranami/blob/master/LICENSE"
              target="_blank"
              rel="noreferrer"
              data-i18n="footer.link.license">License</a>
          </li>
          <li>
            <a
              href="https://github.com/Shironex/shiranami/issues"
              target="_blank"
              rel="noreferrer"
              data-i18n="footer.link.issues">Issues</a>
          </li>
          <li>
            <a
              href="https://github.com/Shironex/shiranami/discussions"
              target="_blank"
              rel="noreferrer"
              data-i18n="footer.link.discussions">Discussions</a>
          </li>
        </ul>
      </div>

    </div>

    <div class="foot-bottom">
      <div data-i18n="footer.copyright">© 2026 · Shironex · Source-available</div>
      <div data-i18n="footer.byline">Made at 03:14 a.m. — somewhere quiet</div>
    </div>
  </div>
</footer>
