---
import { GITHUB_RELEASES_API_URL, GITHUB_RELEASES_LATEST_URL, LANDING_VERSION } from '../lib/site';
import Footer from '../components/Footer.astro';
import Navbar from '../components/Navbar.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { changelog } from '../lib/changelog';

void changelog;
const fallbackPublishedAtIso = new Date().toISOString();
---

<BaseLayout
  title="Download Shiranami"
  description="Download the latest Shiranami desktop build for Windows or macOS."
>
  <Navbar />
  <main id="main" class="section-shell download-page">
    <div class="section-heading reveal">
      <div class="pill" data-i18n="download.pill">Download</div>
      <h1 data-i18n="download.heading">Pick the build that fits your desk.</h1>
      <p data-i18n="download.body">
        We detect your platform and pull the latest build from GitHub so you can start listening.
      </p>
    </div>

    <div class="download-hero reveal">
      <div class="download-summary">
        <div class="version-badge" id="release-version">v{LANDING_VERSION}</div>
        <p id="release-date"></p>
        <strong id="release-title">Latest release</strong>
        <span id="release-state"></span>
      </div>
    </div>

    <div class="platform-grid reveal-stagger" id="platform-grid">
      <article class="platform-card reveal" data-platform="win">
        <div class="platform-top">
          <strong data-i18n="download.windows">Windows</strong>
          <span class="platform-pill" data-recommended hidden data-i18n="download.recommended">Recommended</span>
        </div>
        <p data-i18n="download.windowsDesc">NSIS installer build for the main supported desktop platform.</p>
        <div class="platform-meta">
          <span data-size data-i18n="download.releasePage">Release page</span>
          <span>.exe</span>
        </div>
        <a class="platform-link" id="primary-download" data-download href={GITHUB_RELEASES_LATEST_URL} target="_blank" rel="noreferrer" data-i18n="download.downloadWindows">
          Download Windows build
        </a>
      </article>

      <article class="platform-card reveal" data-platform="mac">
        <div class="platform-top">
          <strong data-i18n="download.macos">macOS</strong>
          <span class="platform-pill" data-recommended hidden data-i18n="download.recommended">Recommended</span>
        </div>
        <p data-i18n="download.macosDesc">DMG build for manual installation from the latest release.</p>
        <div class="platform-meta">
          <span data-size data-i18n="download.releasePage">Release page</span>
          <span>.dmg</span>
        </div>
        <a class="platform-link" data-download href={GITHUB_RELEASES_LATEST_URL} target="_blank" rel="noreferrer" data-i18n="download.downloadMacos">
          Download macOS build
        </a>
      </article>
    </div>

    <div class="note-panel reveal">
      <h2 data-i18n="download.unsignedTitle">Unsigned build notes</h2>
      <p data-i18n="download.unsignedBody">Windows may show SmartScreen. macOS requires a Terminal command after each download before the app will launch.</p>
      <pre><code>xattr -rd com.apple.quarantine /Applications/Shiranami.app</code></pre>
    </div>
  </main>
  <Footer />

  <script is:inline type="application/json" id="localized-release-titles">
    {JSON.stringify(Object.fromEntries(changelog.map((release) => [release.version, release.title])))}
  </script>

  <script
    is:inline
    define:vars={{
      releasesApiUrl: GITHUB_RELEASES_API_URL,
      releasesLatestUrl: GITHUB_RELEASES_LATEST_URL,
      releaseVersionFallback: LANDING_VERSION,
      fallbackPublishedAtIso,
    }}
  >
    const detectPlatform = () => {
      const ua = navigator.userAgent.toLowerCase();
      if (ua.includes('mac')) return 'mac';
      return 'win';
    };

    const getLang = () => (document.documentElement.lang === 'pl' ? 'pl' : 'en');
    const getLocale = () => (getLang() === 'pl' ? 'pl-PL' : 'en-US');
    const getCopy = (key) => {
      const translations = window['__shiranamiLandingTranslations'] ?? {};
      const dict = translations[getLang()] ?? {};
      const fallback = translations.en ?? {};
      return dict[key] ?? fallback[key] ?? '';
    };
    const localizedReleaseTitles = JSON.parse(
      document.getElementById('localized-release-titles')?.textContent ?? '{}'
    );
    const getLocalizedReleaseTitleForPage = (version) => {
      const normalizedVersion = String(version ?? '').replace(/^v/i, '');
      const titles = localizedReleaseTitles[normalizedVersion];
      if (!titles) return null;
      return titles[getLang()] ?? titles.en ?? null;
    };

    const formatPublishedDate = (value) =>
      new Intl.DateTimeFormat(getLocale(), { day: 'numeric', month: 'short', year: 'numeric' }).format(
        new Date(value)
      );

    const formatMegabytes = (bytes) =>
      `${new Intl.NumberFormat(getLocale(), {
        minimumFractionDigits: 1,
        maximumFractionDigits: 1,
      }).format(bytes / (1024 * 1024))} MB`;

    const releaseVersion = document.getElementById('release-version');
    const releaseDate = document.getElementById('release-date');
    const releaseTitle = document.getElementById('release-title');
    const releaseState = document.getElementById('release-state');
    const primaryDownload = document.getElementById('primary-download');
    const platformCards = Array.from(document.querySelectorAll('[data-platform]'));
    const currentPlatform = detectPlatform();
    let releaseData = null;

    const setRecommendedPlatform = (platform) => {
      platformCards.forEach((card) => {
        const recommended = card.querySelector('[data-recommended]');
        const isCurrent = card.dataset.platform === platform;
        card.classList.toggle('is-recommended', isCurrent);
        if (recommended) {
          recommended.hidden = !isCurrent;
        }
      });
    };

    const renderReleaseState = () => {
      releaseVersion.textContent = `v${releaseVersionFallback}`;
      releaseDate.textContent = formatPublishedDate(fallbackPublishedAtIso);
      releaseTitle.textContent = getCopy('download.latestRelease') || 'Latest release';
      releaseState.textContent = '';

      if (!releaseData) return;

      releaseVersion.textContent = releaseData.tag_name;
      releaseDate.textContent = formatPublishedDate(releaseData.published_at);
      releaseTitle.textContent =
        getLocalizedReleaseTitleForPage(releaseData.tag_name) ||
        releaseData.name ||
        getCopy('download.latestPublicBuild') ||
        'Latest public build';
    };

    const updatePlatformCard = (platform, asset) => {
      const card = document.querySelector(`[data-platform="${platform}"]`);
      if (!card || !asset) return;

      const sizeNode = card.querySelector('[data-size]');
      const linkNode = card.querySelector('[data-download]');

      if (sizeNode) {
        sizeNode.textContent = formatMegabytes(asset.size);
        sizeNode.removeAttribute('data-i18n');
      }

      if (linkNode) {
        linkNode.href = asset.browser_download_url;
      }
    };

    const findAsset = (assets, platform) => {
      const patterns = {
        win: /\.exe$/i,
        mac: /\.dmg$/i,
      };

      return assets.find((asset) => patterns[platform]?.test(asset.name));
    };

    setRecommendedPlatform(currentPlatform);
    renderReleaseState();
    document.addEventListener('shiranami:lang-change', () => {
      renderReleaseState();
      if (releaseData) {
        updatePlatformCard('win', findAsset(releaseData.assets, 'win'));
        updatePlatformCard('mac', findAsset(releaseData.assets, 'mac'));
      }
    });

    fetch(releasesApiUrl)
      .then((response) => {
        if (!response.ok) {
          throw new Error('Failed to fetch latest release');
        }
        return response.json();
      })
      .then((release) => {
        releaseData = release;
        renderReleaseState();

        const winAsset = findAsset(release.assets, 'win');
        const macAsset = findAsset(release.assets, 'mac');

        updatePlatformCard('win', winAsset);
        updatePlatformCard('mac', macAsset);

        const preferredAsset = currentPlatform === 'mac' ? macAsset : winAsset;
        if (primaryDownload) {
          primaryDownload.href = preferredAsset?.browser_download_url || release.html_url || releasesLatestUrl;
        }
      })
      .catch(() => {
        releaseData = null;
        renderReleaseState();
      });
  </script>
</BaseLayout>
