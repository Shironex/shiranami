---
import fs from 'node:fs';
import path from 'node:path';
import { getImage } from 'astro:assets';
import poster from '../assets/room-poster.png';
import Footer from '../components/Footer.astro';
import Navbar from '../components/Navbar.astro';
import RoomStage from '../components/room/RoomStage';
import { ROOM_STOPS } from '../components/room/stops';
import BaseLayout from '../layouts/BaseLayout.astro';
import '../styles/room.css';

// Real models live in public/room/models/<prop>.glb. Any prop without a file
// keeps its blockout, so the island is told which files exist. Astro runs dev
// and build from apps/landing, so the path is relative to that.
const modelsDir = path.resolve('public/room/models');
const models = fs.existsSync(modelsDir)
  ? fs
      .readdirSync(modelsDir)
      .filter(file => file.endsWith('.glb'))
      .map(file => file.slice(0, -4))
  : [];

// The poster is the phone LCP: AVIF where supported, WebP otherwise. Built
// with getImage rather than <Picture>, which owns its <picture> element, so
// the desktop blank <source> below can still come first.
const [posterAvif, posterWebp] = await Promise.all(
  (['avif', 'webp'] as const).map(format =>
    getImage({ src: poster, widths: [780, 1280, 1672], format })
  )
);
---

<BaseLayout
  title="白波 · Shiranami — a quiet place for your music"
  description="A local-first desktop sanctuary for your music library, internet radio, synced lyrics, crossfade, and one-step downloads — wrapped in a calm dark lavender theme."
  structuredData
>
  <Navbar />
  <main id="main" class="room" data-room>
    <script is:inline>
      // Decide before first paint whether the 3D room runs at all. Phones,
      // reduced motion and missing WebGL 2 get the poster over stacked copy.
      (function () {
        var room = document.querySelector('[data-room]');
        var gl = false;
        try {
          var ctx = document.createElement('canvas').getContext('webgl2');
          gl = !!ctx;
          var lose = ctx && ctx.getExtension('WEBGL_lose_context');
          if (lose) lose.loseContext();
        } catch (e) {}
        if (
          !gl ||
          matchMedia('(prefers-reduced-motion: reduce)').matches ||
          matchMedia('(max-width: 820px)').matches
        ) {
          room.setAttribute('data-static', '');
        }
      })();
    </script>

    <div class="room-stage" data-room-stage aria-hidden="true">
      <picture>
        {/* Desktop WebGL never shows the poster: the loader covers the wait.
            The script below drops this source when the page went static. */}
        <source
          media="(min-width: 821px) and (prefers-reduced-motion: no-preference)"
          srcset="data:image/gif;base64,R0lGODlhAQABAAAAACw="
          data-room-blank
        />
        <source type="image/avif" srcset={posterAvif.srcSet.attribute} sizes="100vw" />
        <img
          src={posterWebp.src}
          srcset={posterWebp.srcSet.attribute}
          sizes="100vw"
          alt=""
          class="room-poster"
          width={posterWebp.attributes.width}
          height={posterWebp.attributes.height}
          loading="eager"
          fetchpriority="high"
          decoding="async"
        />
      </picture>
      <script is:inline>
        if (document.querySelector('[data-room][data-static]'))
          document.querySelector('[data-room-blank]').remove();
      </script>
      <noscript>
        <style is:inline>
          .room-loader {
            display: none;
          }
          .room .room-poster {
            display: block;
          }
        </style>
        <picture>
          <source type="image/avif" srcset={posterAvif.srcSet.attribute} sizes="100vw" />
          <img
            src={posterWebp.src}
            srcset={posterWebp.srcSet.attribute}
            sizes="100vw"
            alt=""
            class="room-poster"
            width={posterWebp.attributes.width}
            height={posterWebp.attributes.height}
            decoding="async"
          />
        </picture>
      </noscript>
      <div class="room-loader" data-room-loader>
        <svg class="room-loader-record" viewBox="0 0 40 40" aria-hidden="true">
          <circle cx="20" cy="20" r="19" fill="currentColor" opacity="0.18" />
          <circle cx="20" cy="20" r="13" fill="none" stroke="currentColor" opacity="0.25" />
          <circle cx="20" cy="20" r="6" fill="currentColor" opacity="0.7" />
          <path d="M20 1a19 19 0 0 1 16 8.7" fill="none" stroke="currentColor" stroke-width="1.5" />
        </svg>
        <div class="room-loader-bar"><span data-room-loader-bar></span></div>
        <span class="room-loader-pct" data-room-loader-pct>0%</span>
      </div>
      {/* Phones always go static, so they skip hydration (and react-dom) entirely.
          The width matches the static-mode check above. */}
      <RoomStage client:media="(min-width: 821px)" models={models} />
    </div>

    <div class="room-stops">
      {
        ROOM_STOPS.map((stop, index) => {
          const Heading = index === 0 ? 'h1' : 'h2';
          const { panel } = stop;
          return (
            <section
              class="room-stop"
              id={`room-${stop.id}`}
              data-room-stop={stop.id}
              aria-labelledby={`room-${stop.id}-title`}
            >
              <div class="room-panel">
                <div
                  class="room-eyebrow"
                  data-i18n-en={panel.eyebrow.en}
                  data-i18n-pl={panel.eyebrow.pl}
                >
                  {panel.eyebrow.en}
                </div>
                <Heading class="room-heading" id={`room-${stop.id}-title`}>
                  <span data-i18n-en={panel.lead.en} data-i18n-pl={panel.lead.pl}>
                    {panel.lead.en}
                  </span>{' '}
                  <em>
                    <span data-i18n-en={panel.accent.en} data-i18n-pl={panel.accent.pl}>
                      {panel.accent.en}
                    </span>
                  </em>
                </Heading>
                <p class="room-body" data-i18n-en={panel.body.en} data-i18n-pl={panel.body.pl}>
                  {panel.body.en}
                </p>
                {stop.id === 'hero' && (
                  <div class="room-cta">
                    <a href="/download" class="btn-primary" data-i18n="hero.ctaPrimary">
                      Download · Free
                    </a>
                    <a href="#room-library" class="btn-ghost" data-i18n="hero.ctaSecondary">
                      See the room
                    </a>
                  </div>
                )}
                {stop.id === 'download' && (
                  <div class="room-cta">
                    <a href="/download" class="btn-primary">
                      <span>Windows</span>
                      <span class="room-cta-tag" data-i18n="download.windowsTag">
                        .exe · in-app updates
                      </span>
                    </a>
                    <a href="/download" class="btn-ghost">
                      <span>macOS</span>
                      <span class="room-cta-tag" data-i18n="download.macosTag">
                        .dmg · GitHub Releases
                      </span>
                    </a>
                  </div>
                )}
              </div>
            </section>
          );
        })
      }
    </div>

    {/* Progress through the stops; each dot jumps to its stop. */}
    <nav class="room-dots" aria-label="Stops in the room" data-i18n-aria-label="room.stops" data-room-dots>
      {
        ROOM_STOPS.map((stop, index) => (
          <a
            href={`#room-${stop.id}`}
            class="room-dot"
            data-room-dot={index}
            aria-current={index === 0 ? 'step' : undefined}
          >
            <span class="sr-only" data-i18n-en={stop.label.en} data-i18n-pl={stop.label.pl}>
              {stop.label.en}
            </span>
          </a>
        ))
      }
    </nav>

    <button
      type="button"
      class="room-music"
      aria-pressed="false"
      aria-label="Background music"
      data-i18n-aria-label="room.music"
      data-room-music
    >
      <svg viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
        <path d="M9 18V5l11-2v13" />
        <circle cx="6" cy="18" r="3" />
        <circle cx="17" cy="16" r="3" />
      </svg>
      <span class="room-music-bars" aria-hidden="true"><i></i><i></i><i></i></span>
    </button>
  </main>
  <script>
    import { initRoomControls } from '../components/room/controls';
    document.addEventListener('astro:page-load', initRoomControls);
  </script>
  <Footer />
</BaseLayout>
