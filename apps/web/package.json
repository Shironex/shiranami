{
  "name": "@shiranami/web",
  "version": "1.0.1",
  "description": "Shiranami web frontend",
  "private": true,
  "sideEffects": [
    "**/*.css",
    "**/lib/bridge/install.ts"
  ],
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "typecheck": "tsc --noEmit",
    "size": "size-limit",
    "test": "vitest run --project web",
    "test:watch": "vitest --project web",
    "test:cov": "vitest run --project web --coverage",
    "test:storybook": "vitest run --config vitest.storybook.config.ts",
    "storybook": "storybook dev -p 6007",
    "build-storybook": "storybook build"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@radix-ui/react-checkbox": "^1.3.11",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-popover": "^1.1.23",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-slider": "^1.4.7",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-switch": "^1.3.7",
    "@radix-ui/react-tooltip": "^1.2.16",
    "@sentry/react": "10.75.2",
    "@shiranami/contracts": "workspace:*",
    "@shiranami/shared": "workspace:*",
    "@tanstack/react-query": "^5.103.2",
    "@tauri-apps/api": "^2.11.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "fast-average-color": "^9.6.0",
    "i18next": "^26.4.2",
    "lucide-react": "^1.47.0",
    "motion": "^13.4.1",
    "radio-browser-api": "^6.0.3",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-i18next": "^17.0.15",
    "react-window": "^2.3.3",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.5",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@sentry/vite-plugin": "5.4.0",
    "@size-limit/file": "^14.0.0",
    "@storybook/addon-a11y": "^10.6.0",
    "@storybook/addon-docs": "^10.6.0",
    "@storybook/addon-themes": "^10.6.0",
    "@storybook/addon-vitest": "^10.6.0",
    "@storybook/react-vite": "^10.6.0",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^22.20.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/browser": "^4.1.10",
    "@vitest/browser-playwright": "^4.1.10",
    "jsdom": "^30.0.1",
    "playwright": "^1.63.0",
    "size-limit": "^14.0.0",
    "storybook": "^10.6.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "vite": "^8.3.0",
    "vitest": "^4.1.11"
  }
}
