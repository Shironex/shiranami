{
  "name": "@shiranami/web",
  "version": "1.0.1",
  "description": "Shiranami web frontend",
  "private": true,
  "sideEffects": [
    "**/*.css",
    "**/lib/bridge/install.ts",
    "**/src/e2e-bridge.ts"
  ],
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "typecheck": "tsc --noEmit",
    "size": "size-limit",
    "test": "vitest run --project web",
    "test:watch": "vitest --project web",
    "test:cov": "vitest run --project web --coverage",
    "test:storybook": "vitest run --config vitest.storybook.config.ts",
    "storybook": "storybook dev -p 6007",
    "build-storybook": "storybook build"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@radix-ui/react-checkbox": "^1.4.1",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-popover": "^1.3.1",
    "@radix-ui/react-select": "^2.4.1",
    "@radix-ui/react-slider": "^1.6.1",
    "@radix-ui/react-slot": "^1.5.0",
    "@radix-ui/react-switch": "^1.4.1",
    "@radix-ui/react-tooltip": "^1.4.1",
    "@sentry/react": "10.78.0",
    "@shiranami/contracts": "workspace:*",
    "@shiranami/shared": "workspace:*",
    "@tanstack/react-query": "5.105.3",
    "@tauri-apps/api": "^2.12.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "fast-average-color": "^9.6.0",
    "i18next": "^26.4.2",
    "lucide-react": "1.66.0",
    "motion": "^13.4.1",
    "radio-browser-api": "^6.0.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-i18next": "^17.0.15",
    "react-window": "^2.5.3",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "uqr": "0.1.3",
    "zod": "^4.6.7",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@sentry/vite-plugin": "5.4.0",
    "@size-limit/file": "^14.3.0",
    "@storybook/addon-a11y": "10.6.6",
    "@storybook/addon-docs": "10.6.6",
    "@storybook/addon-themes": "10.6.6",
    "@storybook/addon-vitest": "10.6.6",
    "@storybook/react-vite": "10.6.6",
    "@tailwindcss/vite": "4.3.4",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^22.20.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "@vitest/browser": "^4.1.10",
    "@vitest/browser-playwright": "^4.1.10",
    "jsdom": "^30.1.3",
    "playwright": "1.65.0",
    "size-limit": "^14.3.0",
    "storybook": "10.6.6",
    "tailwindcss": "4.3.4",
    "tw-animate-css": "^1.4.0",
    "vite": "^8.3.7",
    "vitest": "^4.1.11"
