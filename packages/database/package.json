{
  "name": "@shiranami/database",
  "version": "0.13.0",
  "private": true,
  "description": "Shiranami database layer using Drizzle ORM with SQLite",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "import": "./dist/client.js",
      "require": "./dist/client.js"
    }
  },
  "typesVersions": {
    "*": {
      "client": [
        "./dist/client.d.ts"
      ]
    }
  },
  "scripts": {
    "build": "tsc --build --clean && tsc",
    "dev": "tsc --watch",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:push": "drizzle-kit push",
    "test": "node ../../scripts/run-vitest.mjs run --project database"
  },
  "dependencies": {
    "drizzle-orm": "^0.45.2",
    "better-sqlite3": "^12.6.2"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^25.5.2",
    "drizzle-kit": "^0.31.8",
    "typescript": "^5.9.3"
  }
}
