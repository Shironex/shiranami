FROM node:22-alpine AS base
RUN corepack enable && corepack prepare pnpm@10.9.0 --activate
WORKDIR /app

# Install dependencies — `...` pulls in the workspace packages @shiranami/server
# depends on (@shiranami/contracts), whose manifest must be in the context for
# pnpm to resolve the `workspace:*` link.
FROM base AS deps
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
# pnpm checks every patchedDependencies file named in pnpm-workspace.yaml even
# when the patched package (expo-audio, mobile only) is filtered out.
COPY patches/ patches/
COPY apps/server/package.json apps/server/
COPY packages/contracts/package.json packages/contracts/
COPY apps/server/prisma/ apps/server/prisma/
RUN pnpm install --frozen-lockfile --filter @shiranami/server... --ignore-scripts

# Build
FROM base AS build
# Bring the whole installed workspace from deps — root manifests included — so
# `pnpm --filter` can resolve the workspace; node_modules (incl. the package
# symlinks) come along.
COPY --from=deps /app ./
COPY tsconfig.base.json ./
# Copy the rarely-changing package first for better layer caching.
COPY packages/contracts/ packages/contracts/
COPY apps/server/ apps/server/
# The server resolves @shiranami/contracts through its package `main`/`types`,
# so the package has to be compiled before nest builds against it.
RUN pnpm --filter @shiranami/contracts run build
# `prisma generate` only reads the schema, but prisma.config.ts resolves
# DATABASE_URL eagerly — hand it a throwaway value so the image builds without a
# database. The real connection string is read from the runtime environment.
RUN DATABASE_URL="postgresql://build:build@localhost:5432/build" \
  pnpm --filter @shiranami/server run db:generate
RUN pnpm --filter @shiranami/server run build

# Production
FROM node:22-alpine AS production
RUN corepack enable && corepack prepare pnpm@10.9.0 --activate
WORKDIR /app

ENV NODE_ENV=production

# yt-dlp for the YouTube proxy (YOUTUBE_PROXY_ENABLED in apps/server/src/features.ts).
# The musl build is self-contained (no Python) and solves YouTube's JS
# challenges with this image's Node. YouTube breaks old versions every few
# months: bump YTDLP_VERSION and both checksums (from the release's
# SHA2-256SUMS) when search or playback starts failing.
ARG YTDLP_VERSION=2026.10.26
ARG YTDLP_SHA256_AMD64=e97a4dd919221d233e7720e18fa3f66db60fbd1d8c0846bf6deb8e88e04475a8
ARG YTDLP_SHA256_ARM64=ea97b8564667f3cabc334c3216526de39bc684e99815ecf07b6642f4cba8af4d
ARG TARGETARCH
RUN set -eux; \
  case "${TARGETARCH:-amd64}" in \
    amd64) asset=yt-dlp_musllinux; sha="$YTDLP_SHA256_AMD64" ;; \
    arm64) asset=yt-dlp_musllinux_aarch64; sha="$YTDLP_SHA256_ARM64" ;; \
    *) echo "no yt-dlp build for $TARGETARCH" >&2; exit 1 ;; \
  esac; \
  wget -qO /usr/local/bin/yt-dlp "https://github.com/yt-dlp/yt-dlp/releases/download/${YTDLP_VERSION}/${asset}"; \
  echo "${sha}  /usr/local/bin/yt-dlp" | sha256sum -c -; \
  chmod 0755 /usr/local/bin/yt-dlp
ENV YTDLP_PATH=/usr/local/bin/yt-dlp

# bgutil PO token provider plugin for yt-dlp. It stays dormant: the server only
# passes `--plugin-dirs` (and the provider URL) when YTDLP_POT_PROVIDER_URL is
# set, so this directory is outside yt-dlp's default plugin paths on purpose.
# The plugin asks a separate provider container for tokens: run the image
# brainicism/bgutil-ytdlp-pot-provider at the same version on a network shared
# with this container, publish no ports, and set
# YTDLP_POT_PROVIDER_URL=http://<provider name>:4416.
# Bump BGUTIL_VERSION and the checksum (the release asset's sha256) together.
ARG BGUTIL_VERSION=2.0.2
ARG BGUTIL_SHA256=a26b980bf6d8e8400d8f21445daa4d8381bf6183d20f0be309391f86b31e27ef
RUN set -eux; \
  dir=/usr/local/share/yt-dlp/plugins/bgutil-ytdlp-pot-provider; \
  wget -qO /tmp/bgutil.zip "https://github.com/Brainicism/bgutil-ytdlp-pot-provider/releases/download/${BGUTIL_VERSION}/bgutil-ytdlp-pot-provider.zip"; \
  echo "${BGUTIL_SHA256}  /tmp/bgutil.zip" | sha256sum -c -; \
  mkdir -p "$dir"; \
  unzip -q /tmp/bgutil.zip -d "$dir"; \
  rm /tmp/bgutil.zip; \
  chmod -R a+rX /usr/local/share/yt-dlp
ENV YTDLP_PLUGIN_DIR=/usr/local/share/yt-dlp/plugins
# Optional: mount a cookies.txt read-only and set YTDLP_COOKIES_FILE to its path
# (see apps/server/src/env.ts for how to export it; it expires).
# yt-dlp unpacks itself and caches YouTube's player code; keep both in /tmp,
# the only place the unprivileged user below may write.
ENV XDG_CACHE_HOME=/tmp/cache TMPDIR=/tmp

COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY patches/ patches/
COPY apps/server/package.json apps/server/
COPY packages/contracts/package.json packages/contracts/
COPY --from=build /app/apps/server/dist ./apps/server/dist
COPY --from=build /app/apps/server/src/generated ./apps/server/src/generated
# @shiranami/contracts is required at runtime (share DTO schemas), so its build
# output ships too — pnpm links node_modules/@shiranami/contracts at this path.
COPY --from=build /app/packages/contracts/dist ./packages/contracts/dist
RUN pnpm install --frozen-lockfile --filter @shiranami/server... --prod --ignore-scripts

# Run as an unprivileged user. 10001 avoids colliding with host uids (1000/1001).
# App files stay root-owned and read-only; the process only writes to /tmp
# (yt-dlp's unpacked files and cache).
RUN addgroup -S -g 10001 app && adduser -S -u 10001 -G app app
USER 10001:10001

EXPOSE 3000
CMD ["node", "apps/server/dist/main.js"]
