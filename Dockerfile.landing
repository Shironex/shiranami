FROM node:22-alpine AS base
RUN corepack enable && corepack prepare pnpm@10.9.0 --activate
WORKDIR /app

FROM base AS deps
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
# pnpm checks every patchedDependencies file named in pnpm-workspace.yaml even
# when the patched package (expo-audio, mobile only) is filtered out.
COPY patches/ patches/
COPY apps/landing/package.json apps/landing/
RUN pnpm install --frozen-lockfile --filter @shiranami/landing...

FROM base AS build
COPY --from=deps /app/node_modules ./node_modules
COPY --from=deps /app/apps/landing/node_modules ./apps/landing/node_modules
COPY apps/landing/ apps/landing/
RUN pnpm --filter @shiranami/landing build

FROM node:22-alpine AS production
RUN npm install -g serve@14
# serve picks up dist/serve.json (from apps/landing/public) for Cache-Control:
# hashed /_astro files for a year, the unhashed room assets for a week, HTML
# and v2.json revalidated on every request.
COPY --from=build /app/apps/landing/dist /app
# Run as an unprivileged user. 10001 avoids colliding with host uids (1000/1001).
# App files stay root-owned and read-only; the process writes nothing at runtime.
RUN addgroup -S -g 10001 app && adduser -S -u 10001 -G app app
USER 10001:10001

EXPOSE 3000
CMD ["serve", "/app", "-l", "3000"]
