{
  "projectId": "019e080e-f887-72ca-bf75-32d4e717aec4",
  "shape": "storybook",
  "pkg": "@shiranami/web",
  "globalName": "ShiranamiWeb",
  "storybookConfigDir": "apps/web/.storybook",
  "storybookStatic": ".design-sync/sb-reference",
  "entry": "apps/web/ds-entry.generated.ts",
  "tsconfig": "tsconfig.dssync.json",
  "provider": {
    "component": "DsPreviewRoot"
  },
  "readmeHeader": ".design-sync/conventions.md",
  "storyImports": {
    "shim": ["/stores/", "/onboarding/stepContext"]
  },
  "libOverrides": {
    "preview-gen-storybook.mjs": "run story beforeEach in compose() so Zustand/query-seeded components render populated (stores exposed on the global by gen-entry.mjs + redirected via storyImports.shim)"
  },
  "overrides": {
    "CommandPalette": {
      "skip": ["shared-commandpalette--default"]
    },
    "KeyboardShortcutsHelp": {
      "skip": ["shared-keyboardshortcutshelp--open"]
    },
    "SubfolderPlaylistDialog": {
      "skip": [
        "settings-subfolderplaylistdialog--default",
        "settings-subfolderplaylistdialog--some-already-exist"
      ]
    },
    "MediaSessionSync": {
      "skip": ["player-mediasessionsync--default"]
    },
    "BulkActionBar": {
      "skip": ["shared-bulkactionbar--default", "shared-bulkactionbar--in-playlist"]
    },
    "EditTagsDialog": {
      "skip": ["shared-edittagsdialog--default"]
    },
    "ImportDialog": {
      "skip": ["shared-importdialog--default"]
    },
    "NowPlayingHero": {
      "skip": ["shared-nowplayinghero--idle"]
    },
    "PlaylistContextMenu": {
      "skip": ["shared-playlistcontextmenu--default"]
    },
    "ShareDialog": {
      "skip": ["shared-sharedialog--default", "shared-sharedialog--playlist"]
    },
    "TrackContextMenu": {
